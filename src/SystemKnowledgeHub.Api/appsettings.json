{
  "ConnectionStrings": {
    "KnowledgeHub": "Data Source=App_Data/system-knowledge-hub.db"
  },
  "Authentication": {
    "Local": {
      "PasswordHasher": {
        "IterationCount": 220000
      },
      "Lockout": {
        "MaxFailedAttempts": 5,
        "WindowMinutes": 15,
        "DurationMinutes": 15
      },
      "RateLimit": {
        "PermitLimit": 20,
        "WindowMinutes": 5
      }
    },
    "Oidc": {
      "Enabled": false,
      "Provider": "",
      "Authority": "",
      "ClientId": "",
      "CallbackPath": "/signin-oidc",
      "Scopes": [ "openid", "profile" ]
    },
    "Cookie": {
      "ExpireHours": 8,
      "SlidingExpiration": true
    }
  },
  "DataProtection": {
    "ApplicationName": "SystemKnowledgeHub",
    "KeyPath": ""
  },
  "Attachments": {
    "StorageRoot": "App_Data/attachments",
    "AllowedImageExtensions": ".png,.jpg,.jpeg,.gif,.webp",
    "AllowedFileExtensions": ".pdf,.docx,.xlsx,.pptx,.txt,.log,.sql,.md,.csv,.json,.xml,.zip",
    "MaxImageBytes": 10485760,
    "MaxFileBytes": 52428800,
    "MaxStoredAttachmentsPerDocument": 100,
    "MemoryBufferThresholdBytes": 65536,
    "UploadRequestOverheadBytes": 2097152,
    "PreviewTextMaxBytes": 262144,
    "PreviewCsvMaxRows": 200,
    "PreviewCsvMaxColumns": 50,
    "PreviewCsvMaxCharacters": 262144,
    "PreviewSpreadsheetMaxWorkbookBytes": 10485760,
    "PreviewSpreadsheetMaxSheets": 20,
    "PreviewSpreadsheetMaxRows": 200,
    "PreviewSpreadsheetMaxColumns": 50,
    "PreviewSpreadsheetMaxSharedStringCharacters": 1048576
  },
  "DatabaseDiscovery": {
    "ConnectionTimeoutSeconds": 15,
    "CatalogCommandTimeoutSeconds": 60,
    "OverallTimeoutSeconds": 900,
    "QueuePollIntervalMilliseconds": 2000,
    "LeaseDurationSeconds": 30,
    "HeartbeatIntervalSeconds": 5,
    "MaximumIncludedSchemas": 128,
    "MaximumObjects": 25000,
    "MaximumColumns": 250000,
    "MaximumConstraintsAndIndexes": 250000,
    "MaximumSequences": 10000,
    "MaximumCanonicalSnapshotBytes": 134217728,
    "MaximumSyncPlanActions": 2000,
    "SqlServerTrustServerCertificate": false
  },
  "Persistence": {
    "Sqlite": {
      "DefaultTimeoutSeconds": 5,
      "BusyTimeoutMilliseconds": 5000
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/system-knowledge-hub-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true,
          "shared": false
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
