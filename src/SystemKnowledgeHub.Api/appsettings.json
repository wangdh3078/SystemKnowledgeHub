{
  "ConnectionStrings": {
    "KnowledgeHub": "Data Source=App_Data/system-knowledge-hub.db"
  },
  "Authentication": {
    "Local": {
      "Lockout": {
        "MaxFailedAttempts": 5,
        "WindowMinutes": 15,
        "DurationMinutes": 15
      },
      "RateLimit": {
        "PermitLimit": 20,
        "WindowMinutes": 5
      }
    },
    "Oidc": {
      "Enabled": false,
      "Provider": "",
      "Authority": "",
      "ClientId": "",
      "CallbackPath": "/signin-oidc",
      "Scopes": [ "openid", "profile" ]
    }
  },
  "DataProtection": {
    "ApplicationName": "SystemKnowledgeHub",
    "KeyPath": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
